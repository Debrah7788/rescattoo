{
  "name": "rescatto-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/ensure-env.mjs",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "npm run setup:env",
    "predev": "npm run db:deploy",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prestart": "npm run db:deploy",
    "start": "npm run build && node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:api": "node scripts/run-api-tests.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:quick": "npm run test:unit && npm run front:test",
    "front:test": "vitest run",
    "e2e": "playwright test",
    "e2e:serve": "tsx src/index.ts",
    "coverage:server": "c8 --all --include 'src/**/*.ts' --exclude 'src/index.ts' --reporter=text --reporter=html --check-coverage --lines 70 --functions 70 --branches 60 --statements 70 node scripts/run-api-tests.mjs --coverage",
    "coverage:front": "vitest run --coverage",
    "coverage": "npm run coverage:server && npm run coverage:front"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "c8": "^12.0.0",
    "jsdom": "^31.0.1",
    "prisma": "^6.16.2",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
