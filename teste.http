@baseUrl = http://localhost:3000
@usuarioContato = fixuser2026@gmail.com
@usuarioSenha = Senha456
@adminContato = fixadmin2026@gmail.com
@adminSenha = Senha789

### Login do usuário para obter token atualizado
# @name loginUsuario
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "contato": "{{usuarioContato}}",
  "senha": "{{usuarioSenha}}",
  "perfil": "usuario"
}

###
@token = {{loginUsuario.response.body.$.token}}

### Login do admin para obter token atualizado
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "contato": "{{adminContato}}",
  "senha": "{{adminSenha}}",
  "perfil": "admin"
}

###
@adminToken = {{loginAdmin.response.body.$.token}}

### ===================================
### GATOS - CRIAR VÁLIDO
### ===================================
# Execute a requisição loginAdmin antes desta requisição.
# @name criarGato
POST {{baseUrl}}/gatos
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nome_gato": "Nina",
  "idade": "2 meses",
  "sexo": "F",
  "cor": "Cinza",
  "porte": "Pequeno",
  "temperamento": "Carinhosa",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada"
}

###
@gatoCriadoId = {{criarGato.response.body.$.id_gato}}

### ===================================
### GATOS - LISTAR TODOS
### ===================================
GET {{baseUrl}}/gatos
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - BUSCAR POR ID
### ===================================
GET {{baseUrl}}/gatos/{{gatoCriadoId}}
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - ATUALIZAR VÁLIDO
### ===================================
PUT {{baseUrl}}/gatos/{{gatoCriadoId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nome_gato": "Luna Atualizada",
  "idade": "4 meses",
  "sexo": "F",
  "cor": "Branco",
  "porte": "Pequeno",
  "temperamento": "Calma",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada e vermifugada"
}

###
### GATOS - CONFIRMAR ATUALIZAÇÃO
GET {{baseUrl}}/gatos/{{gatoCriadoId}}
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - DELETAR VÁLIDO
### ===================================
DELETE {{baseUrl}}/gatos/{{gatoCriadoId}}
Authorization: Bearer {{adminToken}}

###

### ===================================
### GATOS - CONFIRMAR EXCLUSÃO (404)
### ===================================
GET {{baseUrl}}/gatos/{{gatoCriadoId}}
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - BUSCAR INEXISTENTE (404)
### ===================================
GET {{baseUrl}}/gatos/999999
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - CRIAR INVÁLIDO (body vazio)
### ===================================
POST {{baseUrl}}/gatos
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nome_gato": "",
  "idade": "",
  "sexo": ""
}

###

### ===================================
### GATOS - ATUALIZAR INEXISTENTE (404)
### ===================================
PUT {{baseUrl}}/gatos/999
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nome_gato": "Teste",
  "idade": "1 ano",
  "sexo": "M",
  "cor": "Preto",
  "porte": "Médio",
  "temperamento": "Calmo",
  "status": "Disponivel",
  "historico_tratamento": "Nenhum"
}

###

### ===================================
### GATOS - DELETAR INEXISTENTE (404)
### ===================================
DELETE {{baseUrl}}/gatos/999
Authorization: Bearer {{adminToken}}

###

### ===================================
### GATOS - PARAMETRO INVÁLIDO (400)
### ===================================
GET {{baseUrl}}/gatos/abc
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - QUERY INVÁLIDA (400)
### ===================================
GET {{baseUrl}}/gatos?pagina=0&limite=101
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - QUERY VÁLIDA
### ===================================
GET {{baseUrl}}/gatos?pagina=1&limite=10
Authorization: Bearer {{token}}

###

### ===================================
### GATOS - SEM AUTORIZAÇÃO (401)
### ===================================
GET {{baseUrl}}/gatos

###

### ===================================
### GATOS - SEM PERMISSAO DE ADMIN (403)
### ===================================
POST {{baseUrl}}/gatos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_gato": "Gato sem permissão",
  "idade": "1 ano",
  "sexo": "M",
  "cor": "Laranja",
  "porte": "Médio",
  "temperamento": "Brincalhão",
  "status": "Disponivel",
  "historico_tratamento": "Sem histórico"
}

###

### ===================================
### GATOS - BODY INCOMPLETO (400)
### ===================================
POST {{baseUrl}}/gatos
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nome_gato": "Nina",
  "idade": "2 meses",
  "sexo": "F"
}
###
