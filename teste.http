### ===================================

### LISTAR TODOS OS GATOS

### ===================================

GET http://localhost:3000/gatos

###

### ===================================

### BUSCAR GATO POR ID

### ===================================

GET http://localhost:3000/gatos/1

###

### ===================================

### CRIAR GATO

### ===================================

POST http://localhost:3000/gatos
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
"nome_gato": "Nina",
"idade": "2 meses",
"sexo": "F",
"cor": "Cinza",
"porte": "Pequeno",
"temperamento": "Carinhosa",
"status": "Disponivel",
"historico_tratamento": "Vacinada"
}

###

### ===================================

### ATUALIZAR GATO

### ===================================

PUT http://localhost:3000/gatos/1
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
"nome_gato": "Luna Atualizada",
"idade": "4 meses",
"sexo": "F",
"cor": "Branco",
"porte": "Pequeno",
"temperamento": "Calma",
"status": "Disponivel",
"historico_tratamento": "Vacinada e Vermifugada"
}

###

### ===================================

### DELETAR GATO

### ===================================

DELETE http://localhost:3000/gatos/3
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### CASO INVÁLIDO - BUSCAR GATO QUE NÃO EXISTE

### ===================================

GET http://localhost:3000/gatos/999
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### CASO INVÁLIDO - CRIAR GATO SEM DADOS

### ===================================

POST http://localhost:3000/gatos
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
"nome_gato": "",
"idade": "",
"sexo": ""
}

###

### ===================================

### CASO INVÁLIDO - ATUALIZAR GATO INEXISTENTE

### ===================================

PUT http://localhost:3000/gatos/999
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
"nome_gato": "Teste",
"idade": "1 ano",
"sexo": "M",
"cor": "Preto",
"porte": "Médio",
"temperamento": "Calmo",
"status": "Disponivel",
"historico_tratamento": "Nenhum"
}

###

### ===================================

### CASO INVÁLIDO - DELETAR GATO INEXISTENTE

### ===================================

DELETE http://localhost:3000/gatos/999
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### AUTENTICAÇÃO - CADASTRAR USUÁRIO

### ===================================

POST http://localhost:3000/auth/register
Content-Type: application/json

{
"nome": "Gisely",
"endereco": "João Pessoa",
"contato": "[gisely999@gmail.com](mailto:gisely999@gmail.com)",
"senha": "Senha456",
"perfil": "usuario"
}

###

### ===================================

### VALIDAÇÃO - BODY INVÁLIDO (400 + issues)

### ===================================

POST http://localhost:3000/auth/register
Content-Type: application/json

{
"nome": "A",
"contato": "email-invalido",
"senha": "123"
}

###

### ===================================

### VALIDAÇÃO - PARÂMETRO INVÁLIDO (400)

### ===================================

GET http://localhost:3000/gatos/abc
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### VALIDAÇÃO - QUERY INVÁLIDA (400)

### ===================================

GET http://localhost:3000/gatos?pagina=0&limite=101
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### VALIDAÇÃO - QUERY VÁLIDA

### ===================================

GET http://localhost:3000/gatos?pagina=1&limite=10
Authorization: Bearer COLAR_TOKEN

###

### ===================================

### VALIDAÇÃO - JSON MALFORMADO (400)

### ===================================

POST http://localhost:3000/gatos
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
"nome_gato": "Nina",
"idade": "2 meses",
"sexo": "F",

###

